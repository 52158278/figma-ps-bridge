{
  "name": "PS 桥接",
  "id": "figma-ps-bridge-local",
  "api": "1.0.0",
  "main": "code.js",
  "ui": "ui.html",
  "editorType": ["figma"],
  "networkAccess": {
    "allowedDomains": [
      "http://localhost:8765",
      "http://localhost:8766",
      "http://localhost:8767",
      "http://localhost:8768",
      "http://localhost:8769",
      "http://localhost:8770",
      "http://localhost:8771",
      "http://localhost:8772",
      "http://localhost:8773",
      "http://localhost:8774"
    ],
    "reasoning": "与本机运行的桥接服务通信，把选中图片的原始字节发送给 Photoshop，并取回编辑后的图片。桥接服务会在 8765-8774 之间自动选一个空闲端口，避免和代理软件冲突。"
  }
}
